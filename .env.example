# Ledgerly Environment Configuration Template
# Duplicate this file to .env and adjust variables for your local setup.

# Environment Mode: development | testing | production
ENVIRONMENT=development
DEBUG=true

# API Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL 15+)
# Administrative / Migrator Connection (Used for running migrations and initial schema setup)
ADMIN_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ledgerly_dev
ADMIN_TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ledgerly_test

# Application Runtime Connection (Used for normal API operations, strictly bound by RLS)
DATABASE_URL=postgresql+asyncpg://ledgerly_app:ledgerly_secret@localhost:5432/ledgerly_dev
TEST_DATABASE_URL=postgresql+asyncpg://ledgerly_app:ledgerly_secret@localhost:5432/ledgerly_test

# Connection Pool Settings
# In PgBouncer transaction pooling mode, set POOL_PRE_PING to true and POOL_SIZE according to worker count
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Security & Sessions
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string
SESSION_COOKIE_NAME=ledgerly_session
SESSION_LIFETIME_SECONDS=86400

# Email & Notification Provider (dev | smtp)
EMAIL_PROVIDER=dev
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=notifications@ledgerly.io
SMTP_FROM_NAME=Ledgerly Accounting
SMTP_TLS=true

# Outbound Webhook Integration (Optional)
WEBHOOK_SHARED_SECRET=your_webhook_hmac_secret_key

